<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Desktop Hide" Manufacturer="Ajous Production" Version="1.1.5"
           UpgradeCode="6F65C8E3-92E7-46F4-BB16-9D07A30D6A17"
           Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="Je již nainstalována novější verze Desktop Hide." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="DesktopHideIcon" SourceFile="DesktopHide.ico" />
    <Property Id="ARPPRODUCTICON" Value="DesktopHideIcon" />
    <Property Id="ARPPUBLISHER" Value="Ajous Production" />
    <Feature Id="Complete" Title="Desktop Hide" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="DesktopHideFolder" Name="Desktop Hide" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DesktopHideMenuFolder" Name="Desktop Hide" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="ApplicationFiles" Directory="DesktopHideFolder" Guid="*">
      <File Id="DesktopHideExe" Source="$(var.PublishDir)\DesktopHide.exe" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="DesktopHide" Type="string"
                     Value="&quot;[#DesktopHideExe]&quot; --background" />
    </Component>
    <Component Id="StartMenuShortcut" Directory="DesktopHideMenuFolder" Guid="*">
      <Shortcut Id="DesktopHideShortcut" Name="Desktop Hide" Description="Nastavení skrytí ikon a spořiče obrazovky"
                Target="[#DesktopHideExe]" WorkingDirectory="DesktopHideFolder" Icon="DesktopHideIcon" />
      <RemoveFolder Id="RemoveDesktopHideMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\AjousProduction\DesktopHide" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>






